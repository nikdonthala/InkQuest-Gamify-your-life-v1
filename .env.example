# ---- InkQuest environment variables ----

# Server-side only. The Inky AI assistant reads this inside the Vercel serverless
# function (api/chat.mjs). It NEVER ships to the browser.
# Set it in Vercel: Project → Settings → Environment Variables → GROQ_API_KEY
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — dev only. A VITE_-prefixed variable IS bundled into the client, so only
# ever use this for local development, never for production:
# VITE_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
