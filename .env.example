# ---- InkQuest environment variables ----

# AI (Groq) — NEVER put this in the frontend build.
# The production app calls the serverless proxy (api/chat.mjs) which reads this server-side.
# Set it in Vercel: Project → Settings → Environment Variables.
GROQ_API_KEY=

# Optional dev-only AI key — VITE_ variables get bundled into the client, so only use this
# for local development (never in production).
# VITE_GROQ_API_KEY=

# ---- Optional cloud sync (Google sign-in + per-user backup) ----
# Create a free project at https://supabase.com, then copy these from
# Project Settings → API. They are public (safe for the browser) — the server enforces
# row-level security so each user can only read/write their own snapshot row.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase setup (one time, ~2 minutes):
# 1. New project → SQL Editor → run:
#      create table if not exists snapshots (
#        user_id    uuid primary key references auth.users(id) on delete cascade,
#        data       jsonb not null,
#        updated_at timestamptz not null default now()
#      );
#      alter table snapshots enable row level security;
#      create policy "own snapshot" on snapshots
#        for all using (auth.uid() = user_id) with check (auth.uid() = user_id);
# 2. Authentication → Providers → enable "Google" and add your Google OAuth client
#    (https://console.cloud.google.com/apis/credentials), with redirect URL
#    https://<your-project>.supabase.co/auth/v1/callback
# 3. Put VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY in Vercel (and .env.local for dev).
